<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9FC">

    <TextView
        android:id="@+id/txtAshleyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ashley_name"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#674EA7"
        android:gravity="center"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/imgAshley"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="30dp"
        android:src="@drawable/ic_contact_ashley"
        android:contentDescription="@string/ashley_picture"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toBottomOf="@id/txtAshleyTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtAshleyAddress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ashley_address"
        android:textSize="18sp"
        android:textColor="#333333"
        android:gravity="center"
        android:layout_marginTop="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/imgAshley"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtAshleyPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ashley_phone"
        android:textSize="18sp"
        android:textColor="#333333"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/txtAshleyAddress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtAshleyEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ashley_email"
        android:textSize="18sp"
        android:textColor="#333333"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/txtAshleyPhone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>